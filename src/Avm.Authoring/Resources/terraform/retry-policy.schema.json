{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sharedMessagePatterns", "locationIneligiblePatterns", "e2eAllMessagePatterns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sharedMessagePatterns": { "$ref": "#/definitions/patterns" },
    "locationIneligiblePatterns": { "allOf": [{ "$ref": "#/definitions/patterns" }], "minItems": 2 },
    "e2eAllMessagePatterns": { "allOf": [{ "$ref": "#/definitions/patterns" }], "minItems": 2 }
  },
  "definitions": {
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

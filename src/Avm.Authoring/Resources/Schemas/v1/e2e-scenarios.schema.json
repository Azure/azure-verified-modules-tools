{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Use the canonical HTTP identifier so Test-Json resolves its bundled draft-07 meta-schema without a download.",
  "$id": "https://raw.githubusercontent.com/Azure/azure-verified-modules-tools/main/src/Avm.Authoring/Resources/Schemas/v1/e2e-scenarios.schema.json",
  "title": "AVM E2E scenario selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "scenarioPatterns", "moduleTypes"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/Azure/azure-verified-modules-tools/main/src/Avm.Authoring/Resources/Schemas/v1/e2e-scenarios.schema.json"
    },
    "scenarioPatterns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults", "waf-aligned"],
      "properties": {
        "defaults": { "type": "string", "minLength": 1 },
        "waf-aligned": { "type": "string", "minLength": 1 }
      }
    },
    "moduleTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["res", "ptn", "utl"],
      "properties": {
        "res": { "$ref": "#/definitions/moduleType" },
        "ptn": { "$ref": "#/definitions/moduleType" },
        "utl": { "$ref": "#/definitions/moduleType" }
      }
    }
  },
  "definitions": {
    "moduleType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "requiredScenarios", "requiredPolicyBaselines"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "requiredScenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["defaults", "waf-aligned"] }
        },
        "requiredPolicyBaselines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Azure.Pillar.Reliability",
              "CB.AVM.WAF.Security",
              "Azure.Default",
              "Azure.Pillar.Security"
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Azure/azure-verified-modules-tools/main/src/Avm.Authoring/Resources/Schemas/v1/avm-module-metadata.schema.json",
  "title": "AVM module metadata v1",
  "description": "Owner-authored metadata shared by Bicep and Terraform. Module kind and parent identity are derived from the repository, not authored here.",
  "oneOf": [
    { "$ref": "#/definitions/root" },
    { "$ref": "#/definitions/child" }
  ],
  "allOf": [
    {
      "if": {
        "properties": { "canonicalType": { "pattern": "^Microsoft\\." } },
        "required": [ "canonicalType" ]
      },
      "then": { "required": [ "telemetryIdPrefix" ] }
    }
  ],
  "definitions": {
    "schemaReference": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/Azure/azure-verified-modules-tools/main/src/Avm.Authoring/Resources/Schemas/v1/avm-module-metadata.schema.json"
    },
    "schemaVersion": { "type": "integer", "const": 1 },
    "displayName": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "canonicalType": {
      "type": "string",
      "description": "ARM resource type, or the shared pattern/utility taxonomy path.",
      "anyOf": [
        { "pattern": "^Microsoft\\.[A-Z]\\w+(/[a-zA-Z]\\w+)+$" },
        { "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)+$" }
      ]
    },
    "telemetryIdPrefix": {
      "type": "string",
      "description": "Stable telemetry prefix. The ecosystem and module kind must also match the containing module.",
      "pattern": "^46d3x(bcp|trf)\\.(res|ptn|utl)\\.[a-z0-9-]+$",
      "if": { "pattern": "^46d3xbcp\\." },
      "then": { "maxLength": 50 },
      "else": { "maxLength": 59 }
    },
    "tier": {
      "type": "string",
      "enum": [ "core", "maintained" ],
      "description": "Root-module tier, inherited by every child. open-source is reserved and is not a v1 value."
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "individuals" ],
      "properties": {
        "individuals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "githubHandle" ],
            "properties": {
              "githubHandle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 39,
                "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
              }
            }
          }
        },
        "team": {
          "type": "string",
          "description": "Optional shared GitHub team handle, for example @Azure/avm-core-modules.",
          "pattern": "^(@[A-Za-z0-9]+(-[A-Za-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*)?$"
        }
      },
      "anyOf": [
        {
          "properties": { "individuals": { "minItems": 1 } },
          "required": [ "individuals" ]
        },
        {
          "properties": { "team": { "minLength": 1 } },
          "required": [ "team" ]
        }
      ]
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schemaVersion",
        "moduleDisplayName",
        "moduleDescription",
        "canonicalType",
        "tier",
        "owners"
      ],
      "properties": {
        "$schema": { "$ref": "#/definitions/schemaReference" },
        "schemaVersion": { "$ref": "#/definitions/schemaVersion" },
        "moduleDisplayName": { "$ref": "#/definitions/displayName" },
        "moduleDescription": { "$ref": "#/definitions/description" },
        "canonicalType": { "$ref": "#/definitions/canonicalType" },
        "tier": { "$ref": "#/definitions/tier" },
        "owners": { "$ref": "#/definitions/owners" },
        "telemetryIdPrefix": { "$ref": "#/definitions/telemetryIdPrefix" },
        "alternativeNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "comments": { "type": "string" }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schemaVersion",
        "moduleDisplayName",
        "moduleDescription",
        "canonicalType"
      ],
      "properties": {
        "$schema": { "$ref": "#/definitions/schemaReference" },
        "schemaVersion": { "$ref": "#/definitions/schemaVersion" },
        "moduleDisplayName": { "$ref": "#/definitions/displayName" },
        "moduleDescription": { "$ref": "#/definitions/description" },
        "canonicalType": { "$ref": "#/definitions/canonicalType" },
        "telemetryIdPrefix": { "$ref": "#/definitions/telemetryIdPrefix" }
      }
    }
  }
}

// Avm.Authoring pin manifest -- the single source of truth for every
// externally-sourced version this module depends on.
//
// This file is JSONC: PowerShell's ConvertFrom-Json accepts // line comments,
// /* block */ comments, and trailing commas natively on PowerShell 7.4+, so the
// schema can be documented inline. It is loaded by Read-AvmPins and validated
// by Test-AvmPins; an invalid manifest throws.
//
// Regenerate pinned versions and hashes with:
//   ./scripts/Update-AvmPins.ps1 -Terraform <ver> -Tflint <ver> ...
//
// =============================================================================
// tools[] -- managed binary CLIs downloaded into the per-user tool cache
// =============================================================================
//
//   name        (required) lowercase kebab-case identifier
//   version     (required) semver without a leading 'v', e.g. '1.9.5'
//   urlTemplate (required) https:// download URL with placeholders
//   archive     (required) 'zip' | 'tar.gz' | 'raw'
//   entrypoint  (required) lowercase binary basename, no .exe
//   sha256      (required) map of platform key -> 64-char lowercase hex
//
//   Optional keys:
//     platformAliases      per-platform asset-name overrides, for projects
//                          whose release assets do not follow {os}_{arch}
//                          naming (e.g. bicep ships 'win-x64.exe'). Required
//                          whenever urlTemplate references {platform}.
//     unsupportedPlatforms platforms upstream does not ship (e.g. tflint omits
//                          windows-arm64). Those keys must be ABSENT from
//                          sha256; resolve/install throws AVM1012 when the
//                          current host matches.
//     archives             per-platform archive override, for tools that ship
//                          .zip on Windows but .tar.gz elsewhere (e.g.
//                          terraform-docs). When present every supported
//                          platform must be listed and 'archive' is the
//                          documented default.
//
//   Platform keys: windows-amd64, windows-arm64, linux-amd64, linux-arm64,
//                  darwin-amd64, darwin-arm64
//
//   Placeholders: {version} {os} {arch} {platform} {ext}
//     {os}       -> windows | linux | darwin
//     {arch}     -> amd64 | arm64
//     {platform} -> the platformAliases entry for the resolved platform
//     {ext}      -> '.zip' | '.tar.gz' | '' from the effective archive type
//
//   Rules:
//     - urlTemplate MUST start with https://. Mirrors are applied at download
//       time via $env:AVM_MIRROR; this manifest stays canonical. The mirror's
//       scheme, authority, and path prefix are preserved, e.g.
//       AVM_MIRROR='https://m.example.com/proxy' rewrites
//         https://releases.hashicorp.com/terraform/1.9.5/foo.zip
//       to
//         https://m.example.com/proxy/terraform/1.9.5/foo.zip
//       The mirror MUST itself be https://; http:// mirrors are rejected.
//     - sha256 MUST cover every platform except those in unsupportedPlatforms.
//     - The tools list MAY be empty (fixture manifests do this).
{
  "schemaVersion": 1,

  "tools": [
    {
      "name": "bicep",
      "version": "0.47.16",
      "urlTemplate": "https://github.com/Azure/bicep/releases/download/v{version}/bicep-{platform}",
      "archive": "raw",
      "entrypoint": "bicep",
      "platformAliases": {
        "windows-amd64": "win-x64.exe",
        "windows-arm64": "win-arm64.exe",
        "linux-amd64": "linux-x64",
        "linux-arm64": "linux-arm64",
        "darwin-amd64": "osx-x64",
        "darwin-arm64": "osx-arm64"
      },
      "sha256": {
        "windows-amd64": "3f343ab1ce41feac156464adee3dc499cb6c197366fc731aed276192011d867c",
        "windows-arm64": "657e6aacc4e44d73674874f802d98396bf5e2e23530d160f275fbf9d67b7fde7",
        "linux-amd64": "64c345a58e0c3e48b1bc98a4e62d6b3adb1d238281297de3400aeafb2697aa5a",
        "linux-arm64": "4406214cc274cfac7c821552aec2178b80aec637d91ed8b244282964c1cf24e3",
        "darwin-amd64": "8ba5771b5261413d88583829f2ea24509eb65b06d899620c17283ecb60d5ca73",
        "darwin-arm64": "68046a084c88503cf6bd11dacf2a1c4ffcb7e3ac9c6b310d295e024af21bbea4"
      }
    },
    {
      "name": "conftest",
      "version": "0.69.0",
      "urlTemplate": "https://github.com/open-policy-agent/conftest/releases/download/v{version}/conftest_{version}_{platform}{ext}",
      "archive": "tar.gz",
      "entrypoint": "conftest",
      "platformAliases": {
        "windows-amd64": "Windows_x86_64",
        "windows-arm64": "Windows_arm64",
        "linux-amd64": "Linux_x86_64",
        "linux-arm64": "Linux_arm64",
        "darwin-amd64": "Darwin_x86_64",
        "darwin-arm64": "Darwin_arm64"
      },
      "archives": {
        "windows-amd64": "zip",
        "windows-arm64": "zip",
        "linux-amd64": "tar.gz",
        "linux-arm64": "tar.gz",
        "darwin-amd64": "tar.gz",
        "darwin-arm64": "tar.gz"

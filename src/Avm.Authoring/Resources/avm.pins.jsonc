        "darwin-arm64": "ecdef65e24193d627f27c39baeda31295f08c938d8a3d4764f442fb916d4b7dc"
      }
    },
    {
      "name": "terraform-docs",
      "version": "0.24.0",
      "urlTemplate": "https://github.com/terraform-docs/terraform-docs/releases/download/v{version}/terraform-docs-v{version}-{os}-{arch}{ext}",
      "archive": "tar.gz",
      "entrypoint": "terraform-docs",
      "archives": {
        "windows-amd64": "zip",
        "windows-arm64": "zip",
        "linux-amd64": "tar.gz",
        "linux-arm64": "tar.gz",

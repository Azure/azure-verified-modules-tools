      "archives": {
        "windows-amd64": "zip",
        "windows-arm64": "zip",
        "linux-amd64": "tar.gz",
        "linux-arm64": "tar.gz",
        "darwin-amd64": "tar.gz",
        "darwin-arm64": "tar.gz"
      },
      "sha256": {
        "windows-amd64": "f28a44f93ce61a88e931a79cb3a69f280d8ea715120204986583362d4b00a3e1",
        "windows-arm64": "708baf795f002e26a1eef95242850a1e8b890bdaca7eb779ce760cd9118a9a96",
        "linux-amd64": "9a49c168091598358a84dda5f897bf9e363e4f6d951fefdab137e7d25729ea0b",
        "linux-arm64": "1bef217978fc99031e9d0981785e1a183d3ebe2a76bfc961a7acc2a8e718e670",
        "darwin-amd64": "9e339852a1c95a0f10c1f9ea7bd57cb085e7ebf9e726137b78786a087e3e7291",
        "darwin-arm64": "c4661704066d6915a8708b3cc933370fae99d429b8519ff99e791b6c2ed50eac"
      }
    },
    {
      "name": "terraform",
      "version": "1.15.8",
      "urlTemplate": "https://releases.hashicorp.com/terraform/{version}/terraform_{version}_{os}_{arch}.zip",
      "archive": "zip",
      "entrypoint": "terraform",
      "sha256": {
        "windows-amd64": "2ff41d2129afb1982733c132c61a8d6ef038f879f3aeede7fc28b8b8b24acf02",
        "windows-arm64": "ffd9399a37ee8123263d84ec5c00d09d7704f9997cb345d7c9cac56c3fc1348e",
        "linux-amd64": "d25ce7b6902013ad905db3d2eab0be4cd905887fe88b81a6171b8d5503c31f3d",
        "linux-arm64": "8891e9dcedc9e3b8950bc6af9d4d8af1f4cfade3062f53b9dc403a89f6ce8c9c",

        "darwin-arm64": "f210110c5698b94d803a7a63cdb0251b5455c150841478808e2bbb343f95ed68"
      }
    },
    {
      "name": "terraform-docs",
      "version": "0.24.0",
      "urlTemplate": "https://github.com/terraform-docs/terraform-docs/releases/download/v{version}/terraform-docs-v{version}-{os}-{arch}{ext}",
      "archive": "tar.gz",
      "entrypoint": "terraform-docs",
      "archives": {
        "windows-amd64": "zip",
        "windows-arm64": "zip",
        "linux-amd64": "tar.gz",
        "linux-arm64": "tar.gz",
        "darwin-amd64": "tar.gz",
        "darwin-arm64": "tar.gz"
      },
      "sha256": {

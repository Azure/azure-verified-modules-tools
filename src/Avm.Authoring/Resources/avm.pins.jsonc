        "linux-amd64": "tar.gz",
        "linux-arm64": "tar.gz",
        "darwin-amd64": "tar.gz",
        "darwin-arm64": "tar.gz"
      },
      "sha256": {
        "windows-amd64": "8a785b00cca4ef452b1eeac22f53ce21d04efb97a16a2f780906b5503218e6e7",

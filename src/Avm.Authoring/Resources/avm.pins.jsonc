        "windows-arm64": "0576e45158736546ef16bf0f5f6403cb3ec88cc560b23f802bb9d48e0edf65ea",
        "linux-amd64": "0ab9de90c2493f206f8281bae74f9ee2d5ed3605548dab1adf41fef185e1f7c5",
        "linux-arm64": "48d8f152bd78c8848a41a07ac2d12b573306d9329fc961a85354a98a95cc275e",
        "darwin-amd64": "1403cd4b17178c40ee87a40222ce318a31a2b95db7bbcd964c03780cad89dc5e",

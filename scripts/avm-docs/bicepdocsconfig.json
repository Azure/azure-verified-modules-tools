{
  "$schema": "https://raw.githubusercontent.com/Azure/bicep/main/src/vscode-bicep/schemas/bicepdocsconfig.schema.json",
  "input": {
    "include": [
      "**/main.bicep"
    ],
    "exclude": []
  },
  "examples": {
    "reassignments": [
      {
        "from": {
          "include": [
            "**/mg-scope.*/**"
          ]
        },
        "to": "mg-scope"
      },
      {
        "from": {
          "include": [
            "**/rg-scope.*/**"
          ]
        },
        "to": "rg-scope"
      },
      {
        "from": {
          "include": [
            "**/sub-scope.*/**"
          ]
        },
        "to": "sub-scope"
      }
    ]
  }
}

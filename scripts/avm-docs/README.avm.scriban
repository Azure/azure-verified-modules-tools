{{~ func output_type(output) ~}}
{{~ if string.contains custom.typelessOutputs ("|" + output.name + "|") ~}}
{{~ ret "" ~}}
{{~ end ~}}
{{~ if output.secure && output.type == "string" ~}}
{{~ ret "securestring" ~}}
{{~ end ~}}
{{~ if output.secure && output.type == "object" ~}}
{{~ ret "secureObject" ~}}
{{~ end ~}}
{{~ if output.type == "any" ~}}
{{~ ret "" ~}}
{{~ end ~}}
{{~ ret output.type ~}}
{{~ end ~}}
